FROM python:3.13-slim
WORKDIR /app
COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt && useradd --uid 10001 --create-home journal
COPY scripts/ scripts/
COPY templates/ templates/
COPY web/ web/
COPY assets/ assets/
RUN python scripts/build_web_app.py --connected --output-dir dist/web-connected && mkdir -p private/web && chown -R journal:journal private dist
USER journal
EXPOSE 8080
CMD ["python", "scripts/web_api.py", "--prebuilt", "--host", "0.0.0.0", "--port", "8080"]
